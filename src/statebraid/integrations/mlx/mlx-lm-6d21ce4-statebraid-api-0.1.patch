 class LRUPromptCache:
+    external_policy_safe = True
+
+    def transactional_storage(self):
+        """Return exact storage mutation without native policy side effects.
+
+        The caller becomes the sole admission/eviction authority while using
+        this facade. Native LRU capacity and prefix-pruning logic is not run by
+        these exact operations.
+        """
+        if not self.external_policy_safe:
+            raise RuntimeError(
+                f"{type(self).__name__} does not support external-policy storage"
+            )
+        return PromptCacheTransactionalStorage(self)
