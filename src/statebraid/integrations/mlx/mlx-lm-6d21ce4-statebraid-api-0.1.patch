+"""StateBraid reference-integration contract on clean upstream mlx-lm."""
+
+from queue import Queue
+from types import SimpleNamespace
+from typing import Any, cast
+import unittest
+from unittest.mock import Mock, patch
+
+import mlx_lm.models.cache as cache_module
+import mlx_lm.server as server
+
+
+class TinyKV:
+    def __init__(self, nbytes=32):
+        self.nbytes = nbytes
+
+    def is_trimmable(self):
+        return False
+
+
+class StateBraidStorageCapabilityTest(unittest.TestCase):
+    def test_versioned_transactional_storage_bypasses_native_capacity(self):
+        self.assertEqual(cache_module.STATEBRAID_STORAGE_API_VERSION, "0.1")
+        cache = cache_module.LRUPromptCache(max_size=1, max_bytes=1)
+        storage = cache.transactional_storage()
+        self.assertEqual(storage.api_version, "0.1")
+        storage.insert("m", [1], [TinyKV(20)], cache_type="stable")
+        storage.insert("m", [2], [TinyKV(30)], cache_type="active")
+        self.assertEqual(len(cache), 2)
+        self.assertEqual(cache.nbytes, 50)
+
+    def test_native_insert_still_enforces_native_capacity(self):
+        cache = cache_module.LRUPromptCache(max_size=1, max_bytes=1 << 20)
+        cache.insert_cache("m", [1], [TinyKV(20)])
+        cache.insert_cache("m", [2], [TinyKV(20)])
+        self.assertEqual(len(cache), 1)
+
+    def test_capture_remove_restore_preserves_payload_reference(self):
+        cache = cache_module.LRUPromptCache(max_size=1, max_bytes=1)
+        storage = cache.transactional_storage()
+        payload = [TinyKV(20)]
+        storage.insert("m", [1], payload, cache_type="stable")
+        snapshot = storage.capture("m", [1])
+        if snapshot is None:
+            self.fail("inserted snapshot disappeared")
+        self.assertIs(snapshot.prompt_cache, payload)
+        self.assertTrue(storage.remove("m", [1]))
+        self.assertIsNone(storage.capture("m", [1]))
+        storage.restore("m", [1], snapshot)
+        restored = storage.capture("m", [1])
+        if restored is None:
+            self.fail("restored snapshot disappeared")
+        self.assertIs(restored.prompt_cache, payload)
+
+
+class StateBraidServerCapabilityTest(unittest.TestCase):
+    def _run_cache(self, statebraid: bool):
+        provider = SimpleNamespace(
+            cli_args=SimpleNamespace(
+                prompt_cache_size=8,
+                prompt_cache_bytes=4096,
+            )
+        )
+        group = Mock()
+        group.rank.return_value = 0
+        with (
+            patch.object(server, "_STATEBRAID_ON", statebraid),
+            patch.object(server.mx.distributed, "init", return_value=group),
+            patch.object(server, "ResponseGenerator") as generator,
+            patch.object(server, "_run_http_server"),
+        ):
+            server.run("127.0.0.1", 0, cast(Any, provider))
+        return generator.call_args.args[1]
+
+    def test_server_contract_marker_and_request_namespace_field(self):
+        self.assertEqual(server.STATEBRAID_SERVER_API_VERSION, "0.1")
+        self.assertIn("cache_namespace", server.GenerationArguments.__dataclass_fields__)
+
+    def test_default_off_uses_native_lru(self):
+        cache = self._run_cache(False)
+        self.assertEqual(type(cache).__name__, "LRUPromptCache")
+
+    def test_statebraid_on_wraps_native_storage(self):
+        cache = self._run_cache(True)
+        self.assertEqual(type(cache).__name__, "MLXStateBraidPromptCache")
+        self.assertEqual(cache.activation_stats()["mode"], "statebraid")
+
+    def test_request_namespace_is_mechanically_distinct(self):
+        left = server._statebraid_cache_namespace(("model", None), "tenant-a")
+        right = server._statebraid_cache_namespace(("model", None), "tenant-b")
+        again = server._statebraid_cache_namespace(("model", None), "tenant-a")
+        self.assertEqual(left, again)
+        self.assertNotEqual(left, right)
+
+    def test_hostile_namespace_is_rejected(self):
+        with self.assertRaises(ValueError):
+            server._statebraid_cache_namespace(("model", None), "../tenant")
+
+    def test_statebraid_single_path_fails_closed(self):
+        generator = object.__new__(server.ResponseGenerator)
+        queue = Queue()
+        with patch.object(server, "_STATEBRAID_ON", True):
+            generator._serve_single((queue, object(), object()), None)
+        error = queue.get_nowait()
+        self.assertIsInstance(error, RuntimeError)
+        self.assertIsNone(queue.get_nowait())
+
+
+if __name__ == "__main__":
+    unittest.main(verbosity=2)
