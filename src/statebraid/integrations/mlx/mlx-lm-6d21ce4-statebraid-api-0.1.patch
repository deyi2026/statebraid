+class PromptCacheTransactionalStorage:
+    """Versioned exact storage surface consumed by StateBraid adapters."""
+
+    api_version = STATEBRAID_STORAGE_API_VERSION
+
+    def __init__(self, cache: LRUPromptCache):
+        self._cache = cache
+
+    def capture(self, model: Any, tokens: List[int]):
+        tokens = list(tokens)
+        result = self._cache._trie.search(model, tokens)
+        if result.exact is None:
+            return None
+        entry = self._cache._trie.get(model, tokens)
+        return PromptCacheEntrySnapshot(
+            prompt_cache=entry.prompt_cache,
+            nbytes=entry.nbytes,
+            cache_type=entry.cache_type,
+        )
+
+    def remove(self, model: Any, tokens: List[int]) -> bool:
+        tokens = list(tokens)
+        result = self._cache._trie.search(model, tokens)
+        if result.exact is None:
+            return False
+        entry = self._cache._trie.pop(model, tokens)
+        self._cache._lru.remove(model, tokens)
+        self._cache._n_bytes -= entry.nbytes
+        self._cache._n_bytes_by_type[entry.cache_type] = (
+            self._cache._n_bytes_by_type.get(entry.cache_type, 0) - entry.nbytes
+        )
+        return True
+
+    def restore(
+        self, model: Any, tokens: List[int], snapshot: PromptCacheEntrySnapshot
+    ) -> None:
+        self.remove(model, tokens)
+        self._insert_snapshot(model, list(tokens), snapshot)
+
+    def insert(
+        self, model: Any, tokens: List[int], prompt_cache: List[Any], *, cache_type: str
+    ) -> None:
+        snapshot = PromptCacheEntrySnapshot(
+            prompt_cache=prompt_cache,
+            nbytes=sum(c.nbytes for c in prompt_cache),
+            cache_type=cache_type,
+        )
+        self.restore(model, list(tokens), snapshot)
+
+    def _insert_snapshot(
+        self, model: Any, tokens: List[int], snapshot: PromptCacheEntrySnapshot
+    ) -> None:
+        cache_type = snapshot.cache_type
+        if cache_type not in self._cache._lru._lrus:
+            self._cache._lru._lrus[cache_type] = deque()
+            self._cache._lru._ordering.append(cache_type)
+        self._cache._n_bytes_by_type.setdefault(cache_type, 0)
+        entry = LRUPromptCache.CacheEntry(
+            snapshot.prompt_cache, snapshot.nbytes, cache_type
+        )
+        prev = self._cache._trie.add(model, tokens, entry)
+        if prev is not None:
+            raise RuntimeError("exact storage insert unexpectedly replaced an entry")
+        self._cache._lru.push(model, tokens, cache_type)
+        self._cache._n_bytes += entry.nbytes
+        self._cache._n_bytes_by_type[cache_type] += entry.nbytes
