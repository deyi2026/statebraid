+def _statebraid_cache_namespace(model_key, requested_namespace):
+    cache_module = importlib.import_module("statebraid.cache")
+    trust_domain = (
+        cache_module.DEFAULT_TRUST_DOMAIN
+        if requested_namespace is None
+        else requested_namespace
+    )
+    return cache_module.make_cache_namespace(model_key, trust_domain)
+
+
+def _statebraid_generation_safe_hit(prompt_cache, namespace, prompt, cache, rest):
+    adapter = importlib.import_module("statebraid.adapters.mlx")
+    return adapter.generation_safe_prompt_cache_hit(
+        prompt_cache, namespace, prompt, cache, rest
+    )
+
+
+def _statebraid_insert_stable(prompt_cache, namespace, cache_key, cache):
+    return bool(prompt_cache.insert_stable_candidate(namespace, cache_key, cache))
+
+
+def _statebraid_insert_active(prompt_cache, namespace, cache_key, cache, ctx):
+    predecessor = ctx.prompt[: ctx.prompt_cache_count]
+    return bool(
+        prompt_cache.insert_active_successor(
+            namespace,
+            cache_key,
+            cache,
+            predecessor_tokens=predecessor,
+        )
+    )
+
+
+def _statebraid_hybrid_checkpoint(cache_key, prompt):
+    return len(cache_key) + 1 == len(prompt)
+
+
+def _validate_statebraid_reference_backend():
+    cache_module = importlib.import_module("mlx_lm.models.cache")
+    storage_version = getattr(cache_module, "STATEBRAID_STORAGE_API_VERSION", None)
+    if storage_version != "0.1":
+        raise RuntimeError(
+            "StateBraid requires MLX transactional storage API 0.1; "
+            f"found {storage_version!r}"
+        )
+    statebraid_cache = importlib.import_module("statebraid.cache")
+    importlib.import_module("statebraid.adapters.mlx")
+    if not callable(getattr(statebraid_cache, "make_cache_namespace", None)):
+        raise RuntimeError("installed StateBraid lacks cache namespace support")
+
