+class _QuietDisconnectHTTPServer(ThreadingHTTPServer):
+    """ThreadingHTTPServer with client-disconnect-aware error logging.
+
+    BrokenPipeError/ConnectionResetError 意味着客户端已断开（超时/取消），
+    上游默认 handle_error 会打印全量 traceback 到 stderr，掩盖真实异常信号；
+    此处降级为 debug 日志，其余异常仍走默认处理。
+    """
+
+    def handle_error(self, request, client_address):
+        exc = sys.exc_info()[1]
+        if isinstance(exc, (BrokenPipeError, ConnectionResetError)):
+            logging.debug(f"client disconnected: {client_address}: {exc!r}")
+            return
+        super().handle_error(request, client_address)
+
+
