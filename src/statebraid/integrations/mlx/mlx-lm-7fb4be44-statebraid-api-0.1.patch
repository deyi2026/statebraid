+"""Q1 regression tests for disconnect-only HTTP error suppression."""
+
+import inspect
+import os
+import socket
+import sys
+import unittest
+from http.server import ThreadingHTTPServer
+from typing import cast
+from unittest.mock import patch
+
+sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
+
+from mlx_lm.server import (  # noqa: E402
+    _QuietDisconnectHTTPServer,
+    _run_http_server,
+    run,
+)
+
+
+class QuietDisconnectHTTPServerTest(unittest.TestCase):
+    def _dispatch(self, exc: BaseException) -> int:
+        server = object.__new__(_QuietDisconnectHTTPServer)
+        with patch.object(ThreadingHTTPServer, "handle_error") as parent:
+            try:
+                raise exc
+            except BaseException:
+                request = cast(socket.socket, None)
+                server.handle_error(request, ("127.0.0.1", 1))
+            return parent.call_count
+
+    def test_disconnect_errors_are_suppressed(self):
+        self.assertEqual(self._dispatch(BrokenPipeError("gone")), 0)
+        self.assertEqual(self._dispatch(ConnectionResetError("gone")), 0)
+
+    def test_unrelated_errors_delegate_to_parent(self):
+        self.assertEqual(self._dispatch(ValueError("real failure")), 1)
+
+    def test_server_defaults_use_quiet_disconnect_class(self):
+        self.assertIs(
+            inspect.signature(_run_http_server).parameters["server_class"].default,
+            _QuietDisconnectHTTPServer,
+        )
+        self.assertIs(
+            inspect.signature(run).parameters["server_class"].default,
+            _QuietDisconnectHTTPServer,
+        )
+
+
+if __name__ == "__main__":
+    unittest.main(verbosity=2)
