@@ -0,0 +1,68 @@
+"""Regression tests for the lightweight /v1/models endpoint."""
+
+from __future__ import annotations
+
+import http.server
+import json
+import tempfile
+import threading
+import unittest
+import urllib.request
+from pathlib import Path
+from types import SimpleNamespace
+from typing import Any, Dict, Optional, Tuple, cast
+from unittest.mock import patch
+
+from huggingface_hub.errors import CacheNotFound
+
+from mlx_lm.server import APIHandler, ResponseGenerator
+
+
+class ModelsEndpointTest(unittest.TestCase):
+    def request_models(
+        self, *, model: Optional[str] = None
+    ) -> Tuple[int, Dict[str, Any]]:
+        response_generator = cast(
+            ResponseGenerator,
+            SimpleNamespace(
+                cli_args=SimpleNamespace(allowed_origins=["*"], model=model)
+            ),
+        )
+        httpd = http.server.HTTPServer(
+            ("127.0.0.1", 0),
+            lambda *args, **kwargs: APIHandler(
+                response_generator, *args, **kwargs
+            ),
+        )
+        thread = threading.Thread(target=httpd.serve_forever, daemon=True)
+        thread.start()
+        try:
+            url = f"http://127.0.0.1:{httpd.server_port}/v1/models"
+            missing = CacheNotFound("missing test cache", cache_dir="/missing")
+            with patch("mlx_lm.server.scan_cache_dir", side_effect=missing):
+                with urllib.request.urlopen(url, timeout=3) as response:
+                    return response.status, json.loads(response.read())
+        finally:
+            httpd.shutdown()
+            httpd.server_close()
+            thread.join(timeout=2)
+
+    def test_missing_hf_cache_is_an_empty_downloaded_model_set(self) -> None:
+        status, payload = self.request_models()
+
+        self.assertEqual(status, 200)
+        self.assertEqual(payload, {"object": "list", "data": []})
+
+    def test_missing_hf_cache_still_reports_explicit_local_model(self) -> None:
+        with tempfile.TemporaryDirectory(prefix="mlx-models-endpoint-") as model_dir:
+            status, payload = self.request_models(model=model_dir)
+
+            self.assertEqual(status, 200)
+            self.assertEqual(payload["object"], "list")
+            self.assertEqual(len(payload["data"]), 1)
+            self.assertEqual(payload["data"][0]["id"], str(Path(model_dir).resolve()))
+            self.assertEqual(payload["data"][0]["object"], "model")
+
+
+if __name__ == "__main__":
+    unittest.main()
