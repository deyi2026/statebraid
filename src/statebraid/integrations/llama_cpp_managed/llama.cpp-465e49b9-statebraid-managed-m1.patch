index 000000000..12f4531da
--- /dev/null
+++ b/tools/server/tests/unit/test_statebraid_managed_cache.py
@@ -0,0 +1,402 @@
+import pytest
+from utils import *
+
+
+server = ServerPreset.tinyllama2()
+
+
+@pytest.fixture(autouse=True)
+def create_server():
+    global server
+    server = ServerPreset.tinyllama2()
+    server.temperature = 0.0
+    server.n_slots = 1
+    server.cache_ram = 0
+    server.statebraid_managed_cache = True
+    yield
+    server.stop()
+
+
+def get_store():
+    res = server.make_request("GET", "/statebraid/cache")
+    assert res.status_code == 200
+    return res.body
+
+
+def tokenize(prompt: str):
+    res = server.make_request("POST", "/tokenize", data={
+        "content": prompt,
+        "add_special": False,
+    })
+    assert res.status_code == 200
+    return res.body["tokens"]
+
+
+def completion(prompt):
+    res = server.make_request("POST", "/completion", data={
+        "prompt": prompt,
+        "id_slot": 0,
+        "cache_prompt": True,
+        "n_predict": 0,
+    })
+    assert res.status_code == 200
+    return res.body
+
+
+def post_cache(data):
+    return server.make_request("POST", "/statebraid/cache", data=data)
+
+
+def test_statebraid_managed_cache_lifecycle_is_non_destructive_and_fail_closed():
+    server.start()
+
+    initial = get_store()
+    assert initial["enabled"] is True
+    assert initial["n_handles"] == 0
+    assert initial["n_tokens"] == 0
+    assert initial["n_bytes"] == 0
+    epoch = initial["epoch"]
+    assert isinstance(epoch, str) and len(epoch) == 32
+
+    base = tokenize("StateBraid managed RAM lifecycle. " + "alpha beta gamma delta " * 16)
+    extension = base + tokenize("epsilon zeta eta theta")
+
+    cold = completion(base)
+    assert cold["timings"]["cache_n"] == 0
+    assert cold["timings"]["prompt_n"] == len(base)
+
+    wrong_identity = post_cache({
+        "action": "capture",
+        "epoch": epoch,
+        "id_slot": 0,
+        "expected_tokens": base[:-1] + [base[-1] + 1],
+    })
+    assert wrong_identity.status_code == 400
+    assert get_store()["n_handles"] == 0
+
+    captured = post_cache({
+        "action": "capture",
+        "epoch": epoch,
+        "id_slot": 0,
+        "expected_tokens": base,
+    })
+    assert captured.status_code == 200
+    handle = captured.body["handle"]
+    assert handle.startswith("sbm1-")
+    assert captured.body["n_tokens"] > 0
+    assert captured.body["n_bytes"] > 0
+
+    listed = get_store()
+    assert listed["n_handles"] == 1
+    assert listed["handles"][0]["handle"] == handle
+    assert listed["n_bytes"] == captured.body["n_bytes"]
+
+    restore_rows = []
+    for _ in range(2):
+        cleared = post_cache({
+            "action": "clear",
+            "epoch": epoch,
+            "id_slot": 0,
+        })
+        assert cleared.status_code == 200
+        assert cleared.body["n_cleared"] > 0
+
+        restored = post_cache({
+            "action": "restore",
+            "epoch": epoch,
+            "id_slot": 0,
+            "handle": handle,
+        })
+        assert restored.status_code == 200
+        assert restored.body["handle"] == handle
+
+        resumed = completion(extension)
+        cache_n = resumed["timings"]["cache_n"]
+        prompt_n = resumed["timings"]["prompt_n"]
+        assert cache_n > 0
+        assert prompt_n > 0
+        restore_rows.append((cache_n, prompt_n))
+
+        # Restore is intentionally non-destructive: the same handle remains
+        # resident and reusable after each restore.
+        assert get_store()["n_handles"] == 1
+
+    assert restore_rows[0] == restore_rows[1]
+
+    wrong_epoch = post_cache({
+        "action": "restore",
+        "epoch": epoch + "stale",
+        "id_slot": 0,
+        "handle": handle,
+    })
+    assert wrong_epoch.status_code == 400
+
+    invalid_slot = post_cache({
+        "action": "restore",
+        "epoch": epoch,
+        "id_slot": 999,
+        "handle": handle,
+    })
+    assert invalid_slot.status_code == 400
+
+    unknown_handle = post_cache({
+        "action": "restore",
+        "epoch": epoch,
+        "id_slot": 0,
+        "handle": "missing",
+    })
+    assert unknown_handle.status_code == 400
+
+    dropped = post_cache({
+        "action": "drop",
+        "epoch": epoch,
+        "handle": handle,
+    })
+    assert dropped.status_code == 200
+    assert get_store()["n_handles"] == 0
+
+    restore_after_drop = post_cache({
+        "action": "restore",
+        "epoch": epoch,
+        "id_slot": 0,
+        "handle": handle,
+    })
+    assert restore_after_drop.status_code == 400
+
+
+def test_statebraid_managed_cache_rejects_invalid_api_shapes_and_empty_capture():
+    server.start()
+    epoch = get_store()["epoch"]
+
+    for body in (
+        {"action": "capture", "id_slot": 0},
+        {"action": 7, "epoch": epoch},
+        {"action": "capture", "epoch": 7, "id_slot": 0},
+        {"action": "capture", "epoch": epoch, "id_slot": "0"},
+        {"action": "capture", "epoch": epoch, "id_slot": 0, "expected_tokens": []},
+        {"action": "capture", "epoch": epoch, "id_slot": 0, "expected_tokens": ["bad"]},
+        {"action": "restore", "epoch": epoch, "id_slot": 0},
+        {"action": "drop", "epoch": epoch},
+        {"action": "bogus", "epoch": epoch},
+    ):
+        res = post_cache(body)
+        assert res.status_code == 400
+
+    empty = post_cache({
+        "action": "capture",
+        "epoch": epoch,
+        "id_slot": 0,
+        "expected_tokens": [1],
+    })
+    assert empty.status_code == 400
+
+
+def test_statebraid_managed_cache_epoch_changes_across_restart():
+    server.start()
+    epoch1 = get_store()["epoch"]
+    prompt = tokenize("StateBraid restart epoch qualification.")
+    completion(prompt)
+    captured = post_cache({
+        "action": "capture",
+        "epoch": epoch1,
+        "id_slot": 0,
+        "expected_tokens": prompt,
+    })
+    assert captured.status_code == 200
+    handle = captured.body["handle"]
+
+    server.stop()
+    server.start()
+
+    epoch2 = get_store()["epoch"]
+    assert epoch2 != epoch1
+    assert get_store()["n_handles"] == 0
+
+    stale = post_cache({
+        "action": "restore",
+        "epoch": epoch1,
+        "id_slot": 0,
+        "handle": handle,
+    })
+    assert stale.status_code == 400
+
+
+def test_statebraid_managed_cache_is_opt_in():
+    server.statebraid_managed_cache = False
+    server.start()
+
+    res = server.make_request("GET", "/statebraid/cache")
+    assert res.status_code != 200
+    assert "disabled" in str(res.body).lower()
+
+
+def test_statebraid_managed_cache_rejects_native_ram_cache_split_brain():
+    server.cache_ram = 8
+    with pytest.raises(RuntimeError):
+        server.start(timeout_seconds=30)
+
+
+def test_statebraid_managed_cache_rejects_non_loopback_bind():
+    server.server_host = "0.0.0.0"
+    with pytest.raises(RuntimeError):
+        server.start(timeout_seconds=30)
+
+
+def _budget_server():
+    budget_server = ServerPreset.tinyllama2()
+    budget_server.temperature = 0.0
+    budget_server.n_slots = 1
+    budget_server.cache_ram = 0
+    budget_server.statebraid_managed_cache = True
+    budget_server.statebraid_managed_cache_ram = 1  # 1 MiB
+    return budget_server
+
+
+def _prime_slot(server, epoch):
+    prompt = "statebraid budget probe " + "alpha beta gamma delta " * 16
+    toks = server.make_request("POST", "/tokenize", data={
+        "content": prompt,
+        "add_special_tokens": False,
+    }).body["tokens"]
+    done = server.make_request("POST", "/completion", data={
+        "prompt": toks,
+        "id_slot": 0,
+        "cache_prompt": True,
+        "n_predict": 0,
+    })
+    assert done.status_code == 200
+    return toks
+
+
+def _capture(server, epoch, toks):
+    return server.make_request("POST", "/statebraid/cache", data={
+        "action": "capture",
+        "epoch": epoch,
+        "id_slot": 0,
+        "expected_tokens": toks,
+    })
+
+
+def _restore(server, epoch, handle):
+    return server.make_request("POST", "/statebraid/cache", data={
+        "action": "restore",
+        "epoch": epoch,
+        "id_slot": 0,
+        "handle": handle,
+    })
+
+
+def _list_handles(server):
+    res = server.make_request("GET", "/statebraid/cache")
+    assert res.status_code == 200
+    return res.body
+
+
+def test_statebraid_managed_cache_ram_budget_rejects_when_all_handles_are_in_use():
+    budget_server = _budget_server()
+    try:
+        budget_server.start()
+
+        epoch = _list_handles(budget_server)["epoch"]
+        toks = _prime_slot(budget_server, epoch)
+
+        # in-use (restored) handles are protected: captures must accumulate
+        # up to the budget, then be rejected with no side effects
+        first_handle = None
+        rejected = None
+        for _ in range(20):
+            res = _capture(budget_server, epoch, toks)
+            if res.status_code != 200:
+                rejected = res
+                break
+            assert res.body["evicted"] == []
+            if first_handle is None:
+                first_handle = res.body["handle"]
+            restored = _restore(budget_server, epoch, res.body["handle"])
+            assert restored.status_code == 200
+        assert rejected is not None
+        assert rejected.status_code == 400
+        assert "budget" in rejected.body["error"]["message"]
+
+        after = _list_handles(budget_server)
+        assert after["n_bytes"] <= 1 * 1024 * 1024
+
+        # refusal must not have destroyed the protected handles
+        again = _restore(budget_server, epoch, first_handle)
+        assert again.status_code == 200
+        rows = {row["handle"]: row for row in after["handles"]}
+        assert rows[first_handle]["restored"] is True
+    finally:
+        budget_server.stop()
+
+
+def test_statebraid_managed_cache_evicts_oldest_unused_handle_under_pressure():
+    budget_server = _budget_server()
+    try:
+        budget_server.start()
+
+        epoch = _list_handles(budget_server)["epoch"]
+        toks = _prime_slot(budget_server, epoch)
+
+        first = _capture(budget_server, epoch, toks)
+        assert first.status_code == 200
+        orphan = first.body["handle"]
+
+        # keep capturing without restoring until pressure evicts the oldest
+        evicted_in = None
+        for _ in range(30):
+            res = _capture(budget_server, epoch, toks)
+            if res.status_code != 200:
+                assert "budget" in res.body["error"]["message"]
+                break
+            if res.body["evicted"]:
+                evicted_in = res
+                break
+        assert evicted_in is not None, "expected an eviction under the 1 MiB budget"
+        # equal-size captures: the first eviction's deficit is one handle,
+        # so exactly the oldest unused handle is reclaimed, nothing younger
+        assert evicted_in.body["evicted"] == [orphan]
+
+        listed = _list_handles(budget_server)
+        live = {row["handle"] for row in listed["handles"]}
+        assert orphan not in live
+        assert evicted_in.body["handle"] in live  # new capture survived
+
+        # an evicted handle is gone for good
+        gone = _restore(budget_server, epoch, orphan)
+        assert gone.status_code == 400
+        assert "Unknown" in gone.body["error"]["message"]
+    finally:
+        budget_server.stop()
+
+
+def test_statebraid_managed_cache_list_reports_restored_and_creation_order():
+    ordered = ServerPreset.tinyllama2()
+    ordered.temperature = 0.0
+    ordered.n_slots = 1
+    ordered.cache_ram = 0
+    ordered.statebraid_managed_cache = True
+    try:
+        ordered.start()
+
+        body = _list_handles(ordered)
+        epoch = body["epoch"]
+        toks = _prime_slot(ordered, epoch)
+
+        first = _capture(ordered, epoch, toks)
+        second = _capture(ordered, epoch, toks)
+        assert first.status_code == 200 and second.status_code == 200
+
+        rows = _list_handles(ordered)["handles"]
+        assert [row["handle"] for row in rows] == [
+            first.body["handle"],
+            second.body["handle"],
+        ]  # map order is creation order, oldest first
+        assert all(row["restored"] is False for row in rows)
+
+        assert _restore(ordered, epoch, second.body["handle"]).status_code == 200
+        rows = {row["handle"]: row for row in _list_handles(ordered)["handles"]}
+        assert rows[first.body["handle"]]["restored"] is False
+        assert rows[second.body["handle"]]["restored"] is True
+    finally:
+        ordered.stop()
